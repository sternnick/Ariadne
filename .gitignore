# Scratch and tooling noise stay out of the public tree.
/.work/*
# EXCEPT the distilled lane reports: docs/ cites them as primary evidence.
!/.work/lanes/
# The operator's own CV, if it ever exists locally. Defence in depth only -- D-011 records that
# this is NOT the control (git add -f exists), which is why the corpus is synthetic-only.
/personal/
/data/local/
/cache/
*.log
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
